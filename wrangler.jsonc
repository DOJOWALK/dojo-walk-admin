{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dojo-walk-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dojo-walk-admin"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dojo-walk-db",
      "database_id": "041e1b93-c472-48cf-9752-0a00118a270d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Dojo Walk",
    "APP_TIMEZONE": "Asia/Kolkata"
  },
  "env": {
    "testing": {
      "name": "dojo-walk-testing",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "dojo-walk-testing"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dojo-walk-preview-db",
          "database_id": "d220195d-8d07-4dba-a97e-f2f68bca249c",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_NAME": "Dojo Walk Testing",
        "APP_TIMEZONE": "Asia/Kolkata",
        "PORTAL_OTP_MODE": "demo",
        "OTP_PEPPER": "dojo-walk-preview-only-demo-pepper-not-for-production"
      }
    }
  }
}
